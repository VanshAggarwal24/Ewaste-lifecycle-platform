# =============================================================================
#  EcoCycle backend — environment template
#  Copy this file to `.env` and fill in real values. NEVER commit the real .env.
# =============================================================================

# --- Server -------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# --- Database (PostgreSQL) ----------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecocycle_dev?schema=public"

# Separate database used by the automated test suite. It is migrated automatically
# by `npm test` and is truncated between tests — never point it at real data.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecocycle_test?schema=public"

# --- Security -----------------------------------------------------------------
# Generate a strong value, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-me-with-a-long-random-secret-string"
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=10

# --- CORS ---------------------------------------------------------------------
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Rate limiting ------------------------------------------------------------
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX_ATTEMPTS=20
API_RATE_LIMIT_WINDOW_MINUTES=15
API_RATE_LIMIT_MAX_REQUESTS=600

# --- Pickup assignment scoring (rule-based, deterministic) --------------------
# Hard eligibility filters
ASSIGN_MAX_DISTANCE_KM=50
ASSIGN_MAX_DAILY_PICKUPS=10
# Weights: distance + workload + availability + capacity must not all be zero.
ASSIGN_WEIGHT_DISTANCE=0.45
ASSIGN_WEIGHT_WORKLOAD=0.25
ASSIGN_WEIGHT_AVAILABILITY=0.20
ASSIGN_WEIGHT_CAPACITY=0.10
# Candidates returned in the explainability log
ASSIGN_CANDIDATE_POOL=10
