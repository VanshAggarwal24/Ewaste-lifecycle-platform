# =============================================================================
#  EcoCycle frontend — environment template (Vite)
#  Copy to `.env` for local development. Only VITE_* variables reach the browser.
# =============================================================================

# Base URL of the EcoCycle API.
# Leave EMPTY in development: the Vite dev server proxies /api to http://localhost:4000,
# which keeps the browser on a single origin and avoids CORS entirely.
VITE_API_URL=

# Where the dev-server proxy sends /api requests (backend port from backend/.env).
VITE_PROXY_TARGET=http://localhost:4000
