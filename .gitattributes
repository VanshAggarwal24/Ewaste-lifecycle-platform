# Normalise line endings so the project behaves the same on Windows, macOS and Linux.
* text=auto

# Shell scripts must keep LF.
*.sh text eol=lf

# Windows helper scripts keep CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf

# Prisma migrations and SQL files are line-sensitive: keep them exactly as written.
*.sql text eol=lf
prisma/migrations/** text eol=lf

# Binary assets should never be converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
